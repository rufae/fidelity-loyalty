# LocalAI Fidelity — variables de entorno (FASE 1)
# Copia este fichero a `.env` y ajusta los valores.
# NUNCA versiones `.env` ni pongas secretos reales en este fichero (AGENTS.md §16.1).

# --- Entorno ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Puertos (libres en la torre, ADR-0002) ---
WEB_PORT=8100
API_PORT=8101
DATABASE_PORT=5434

# --- PostgreSQL (solo valores de desarrollo) ---
POSTGRES_USER=localai
POSTGRES_PASSWORD=localai
POSTGRES_DB=localai_fidelity

# URL usado por el backend.
# - En local (fuera de Docker): localhost:5434
# - En docker-compose se sobreescribe a `db:5432`
DATABASE_URL=postgresql+psycopg://localai:localai@localhost:5434/localai_fidelity

# --- Backend ---
# URL que el frontend (Next.js) usa para hacer proxy hacia la API.
API_URL=http://localhost:8101

# Base pública canónica: con ella los QR y las URLs que se escriben en las
# etiquetas NFC salen ABSOLUTAS (un QR con ruta relativa no abre nada al
# escanearlo con el móvil). Usa la dirección por la que te alcancen los
# dispositivos: p. ej. http://<ip-tailscale>:8100 en local o https://tu-dominio
# en producción.
# En producción debe ser https:// con un dominio público accesible desde los
# móviles de los clientes (una IP privada o un nombre .ts.net no les sirve).
# Si decides un servicio SOLO privado, márcalo además con
# ALLOW_PRIVATE_PUBLIC_BASE_URL=true.
PUBLIC_BASE_URL=http://localhost:8100
# ALLOW_PRIVATE_PUBLIC_BASE_URL=false

# --- Wallet (§6.6, ADR-0002) ---
# `simulated` por defecto: sin credenciales Apple/Google y rotulado como
# SIMULATED en la UI (§17.2). Los valores `apple`/`google` se configurarán en
# la FASE 7 y FASE 8, cuando existan certificados e issuer reales.
WALLET_PROVIDER=simulated

# --- FASE 7: Apple Wallet (certificados; se dejan comentados a propósito) ---
# APPLE_PASS_TYPE_IDENTIFIER=
# APPLE_TEAM_IDENTIFIER=
# APPLE_PASS_CERT_PATH=
# APPLE_WWDR_CERT_PATH=
# APPLE_PASS_CERT_PASSWORD=
# APPLE_APNS_KEY_PATH=
# APPLE_APNS_KEY_ID=

# --- FASE 8: Google Wallet (cuenta de servicio) ---
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# GOOGLE_WALLET_ENVIRONMENT=test

# --- FASE 10: firma de rutas cortas /go/{slug} (§12.8) ---
# NFC_REDIRECT_SIGNING_SECRET=   # openssl rand -hex 32

# --- FASE 2: autenticación multiempresa (§8.3) ---
# La autenticación NO puede desactivarse: en producción, un arranque sin
# AUTH_SESSION_SECRET termina con error (fail-closed, §16.2).
#
# ⚠ SOLO DESARROLLO LOCAL: los valores de abajo crean un administrador inicial
#   cuando la tabla de usuarios está vacía. En producción genera los tuyos:
#   AUTH_SESSION_SECRET=$(openssl rand -hex 32)
#   AUTH_BOOTSTRAP_PASSWORD=$(openssl rand -base64 24)

# Correo transaccional para verificar altas y recuperar tarjetas.
# Desarrollo: apunta al contenedor `mailpit` (UI: http://localhost:8025).
# Producción: usa SMTP real con cifrado; la API NO arranca en producción sin
# EMAIL_FROM, EMAIL_SMTP_HOST y TLS (EMAIL_SMTP_SSL o EMAIL_SMTP_STARTTLS).
EMAIL_FROM=alta@fidelity.test
EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=false
EMAIL_SMTP_SSL=false
EMAIL_SMTP_TIMEOUT_SECONDS=10
AUTH_SESSION_SECRET=desarrollo-local-sin-secreto-real
AUTH_BOOTSTRAP_EMAIL=admin@fidelity.example.com
AUTH_BOOTSTRAP_PASSWORD=contrasena-de-desarrollo-1234
# AUTH_SESSION_TTL_SECONDS=604800

# --- Apple Wallet (FASE 5) ---
# Rutas PEM montadas como secretos; nunca se versionan ni llegan al frontend.
# Sin ellas el proveedor queda `not_configured` y la app funciona con tarjeta web.
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_PASS_CERT_PATH=
APPLE_PASS_KEY_PATH=
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_CERT_PATH=

# --- Google Wallet (FASE 6) ---
GOOGLE_WALLET_ISSUER_ID=
# Ruta al JSON de la cuenta de servicio (montado como secreto) o su contenido.
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=

# --- Trabajos Wallet (§15) ---
WALLET_JOB_MAX_ATTEMPTS=5
WALLET_JOB_BACKOFF_SECONDS=30
# El worker de reintentos se activa en el despliegue; en pruebas se ejecuta
# `run_due_jobs` de forma explícita.
WALLET_WORKER_ENABLED=true
WALLET_WORKER_POLL_SECONDS=15

# --- Soporte B2B (Plan.md §11) ---
# El buzón del panel funciona siempre. Email/ntfy/Telegram son capas de aviso
# opcionales; el teléfono de llamada se cifra y nunca sale en correos ni push.
SUPPORT_EMAIL_ENABLED=true
# Correo privado del propietario de la plataforma; nunca se muestra al comercio.
SUPPORT_NOTIFICATION_EMAIL=
# Remitente genérico del soporte; si falta se usa EMAIL_FROM.
SUPPORT_FROM_EMAIL=
SUPPORT_NTFY_ENABLED=false
# Servidor ntfy autoalojado: `docker compose up -d ntfy` lo levanta en
# loopback (127.0.0.1:8178) y la API lo alcanza por la red interna
# (`http://ntfy:80`). Para que un móvil reciba avisos hay que suscribirse al
# tema; exponer el servidor a Internet requiere decisión explícita (§18.2).
SUPPORT_NTFY_BASE_URL=http://ntfy:80
SUPPORT_NTFY_TOPIC=fidelity-soporte-plataforma
SUPPORT_NTFY_TOKEN=
SUPPORT_TELEGRAM_ENABLED=false
SUPPORT_TELEGRAM_BOT_TOKEN=
SUPPORT_TELEGRAM_CHAT_ID=
SUPPORT_WORKER_ENABLED=true
SUPPORT_WORKER_POLL_SECONDS=15
SUPPORT_NOTIFICATION_MAX_ATTEMPTS=5
SUPPORT_NOTIFICATION_BACKOFF_SECONDS=30
# openssl rand -hex 32
SUPPORT_PHONE_ENCRYPTION_KEY=
SUPPORT_THREAD_RATE_LIMIT_PER_DAY=5
SUPPORT_MESSAGE_RATE_LIMIT_PER_DAY=20
SUPPORT_CALLBACK_RATE_LIMIT_PER_DAY=3
